{
    "settings": {
      "development": true,
      "logging": false
    },
    "services": [
      {
        "name": "service0",
        "protocol": "http",
        "clusters": [
          {
            "replicas": 1,
            "node": "worker1"
          }
        ],
        "resources": {
          "limits": {
            "memory": "1024M",
            "cpu": "1000m"
          },
          "requests": {
            "memory": "512M",
            "cpu": "1000m"
          }
        },
        "processes": 10,
        "endpoints": [
          {
            "name": "endpoint1",
            "execution_mode": "sequential",
            "cpu_complexity": {
              "execution_time": 0.001
            },
            "network_complexity": {
              "forward_requests": "synchronous",
              "response_payload_size": 256,
              "called_services": [
                {
                  "service": "service1",
                  "port": 80,
                  "endpoint": "endpoint1",
                  "protocol": "http",
                  "traffic_forward_ratio": 1,
                  "request_payload_size": 512
                }
              ]
            }
          }
        ]
      },
      {
        "name": "service1",
        "protocol": "http",
        "clusters": [
          {
            "replicas": 1,
            "node": "worker2"
          }
        ],
        "resources": {
          "limits": {
            "memory": "1024M",
            "cpu": "1000m"
          },
          "requests": {
            "memory": "512M",
            "cpu": "1000m"
          }
        },
        "processes": 10,
        "endpoints": [
          {
            "name": "endpoint1",
            "execution_mode": "sequential",
            "cpu_complexity": {
              "execution_time": 0.001
            }
          }
        ]
      }
    ]
  }
  